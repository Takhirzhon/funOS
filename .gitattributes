# Normalise line endings in the repository. This project is edited on Windows
# with core.autocrlf=true and executed on Linux; a CRLF that slipped into
# auto_deploy.sh would fail on the box with `$'\r': command not found`, and
# into the Dockerfile with a build error on every deploy.
* text=auto

# Files the box or the container executes or parses: always LF on checkout,
# whatever the local autocrlf says.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
*.inc           text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Binary, never touch.
*.woff          binary
*.woff2         binary
*.png           binary
*.ico           binary
*.jpg           binary
